#!/bin/sh
  
set -e
umask 0002

OPTIONS="--show - \
         --select-base /usr/libexec/device/state/system/auth/sssd/session/scope.txt --select scope \
         --text notice"

if [ "$1" == "--" ]; then

  /usr/libexec/device-tool ${OPTIONS} "$@"

elif [ "$1" == "-c" ]; then

  /usr/libexec/device-tool ${OPTIONS} "$@"

fi


